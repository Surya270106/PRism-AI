# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/prism_db"

# Next Auth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Authentication Providers
GITHUB_ID="your_github_oauth_app_client_id"
GITHUB_SECRET="your_github_oauth_app_client_secret"

# ML Pipeline Configuration (For legacy Groq/HuggingFace support)
GROQ_API_KEY="your_groq_api_key_here"
HF_TOKEN="your_huggingface_token_here"

# Enterprise Orchestrator Configuration
ORCHESTRATOR_URL="http://localhost:8001/api/v1/review"
USE_LOCAL_MODEL="true"
USE_CLAUDE_FALLBACK="true"
LLAMA_SERVER_URL="http://localhost:8000/review"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
