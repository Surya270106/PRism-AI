    "test": "npm run test --workspace=web && pytest apps/orchestrator/tests"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "dotenv": "^17.4.2",
    "prisma": "^5.22.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {}
}
